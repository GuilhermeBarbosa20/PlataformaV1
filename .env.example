OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Meta / Instagram Login (mesmo redirect que em "Valid OAuth Redirect URIs")
APIFY_API_TOKEN=apify_api_your_token_here
APIFY_INSTAGRAM_SCRAPER_ACTOR=apify/instagram-scraper
APIFY_INSTAGRAM_POST_SCRAPER_ACTOR=apify/instagram-post-scraper
APIFY_INSTAGRAM_REEL_SCRAPER_ACTOR=apify/instagram-reel-scraper
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_REDIRECT_URI=https://your-domain.example/agents/social-media/auth/callback
META_INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_manage_insights
META_INSTAGRAM_GRAPH_VERSION=v22.0
META_COOKIE_SECURE=0
# Cadeia de actors LinkedIn (tentados por ordem). sourabhbgp/linkedin-profile-scraper está bloqueado.
APIFY_LINKEDIN_ACTOR_CHAIN=harvestapi/linkedin-profile-posts,harvestapi/linkedin-company-employees,LQQIXN9Othf8f7R5n
APIFY_LINKEDIN_POSTS_ACTOR=LQQIXN9Othf8f7R5n
APIFY_LINKEDIN_POSTS_LIMIT=50

# --- LinkedIn (Agente LinkedIn — OAuth, publicação, análise de perfil via Apify) ---
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=http://127.0.0.1:8000/agents/linkedin/auth/callback
# Callback OAuth para publicar posts (w_member_social) — adiciona também no LinkedIn Developer → Auth → Redirect URLs
LINKEDIN_PUBLISH_REDIRECT_URI=http://127.0.0.1:8000/agents/linkedin/connect-publish/callback
LINKEDIN_SCOPES=openid profile email w_member_social
LINKEDIN_COOKIE_SECURE=0
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
