# Copia para .env e preenche com as tuas chaves (nunca commits o .env).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Apify (OPCIONAL) ---
# Token usado pelo Agente de Redes Sociais para obter dados Instagram via
# actors Apify. Se ficar vazio, a app faz fallback automático para
# scraping web público (resultado mais limitado, mas funcional).
APIFY_API_TOKEN=
# Actor que recolhe dados do perfil (followers, bio, últimos posts):
APIFY_INSTAGRAM_SCRAPER_ACTOR=apify/instagram-scraper
# Actor que recolhe os últimos posts em detalhe (para distribuição por
# formato, top conteúdos, cadência, hashtags):
APIFY_INSTAGRAM_POST_SCRAPER_ACTOR=apify/instagram-post-scraper
# Actor que recolhe Reels em detalhe (playCount, duração, top reels):
APIFY_INSTAGRAM_REEL_SCRAPER_ACTOR=apify/instagram-reel-scraper

# --- Meta / Instagram Login (OPCIONAL) ---
# Necessário apenas se quiseres login Instagram para análise da tua conta.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
