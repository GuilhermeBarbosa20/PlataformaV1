# ================================================
# Environment Variables Template
# Copy this file to .env and fill in your values
# ================================================

# ============================================
# REQUIRED: Supabase Configuration
# ============================================
# Get from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Service Role Key (for server-side admin operations)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# REQUIRED: OpenAI API
# ============================================
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# ============================================
# REQUIRED: Google Cloud / Vertex AI
# ============================================
# Choose ONE method:

# METHOD 1: Base64 encoded credentials (RECOMMENDED for production)
# Convert your service account JSON file to base64:
#   Linux/Mac: base64 -w 0 service-account.json
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
GOOGLE_CREDENTIALS_BASE64=your-base64-encoded-json-here

# METHOD 2: Individual environment variables
# Uncomment and fill these if not using base64:
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY_ID=your-private-key-id
# GOOGLE_CLIENT_ID=your-client-id

# METHOD 3: File path (DEVELOPMENT ONLY - not for production)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Vertex AI Configuration
VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=us-central1
# Gemini 2.5 Flash Image with Identity Preservation
# Options: gemini-2.5-flash-preview-05-20, imagen-3.0-generate-001
VERTEX_IMAGE_MODEL=gemini-2.5-flash-preview-05-20

# ============================================
# REQUIRED: Apify (LinkedIn Scraping)
# ============================================
# Get from: https://console.apify.com/account/integrations
APIFY_TOKEN=apify_api_your-token-here

# ============================================
# REQUIRED: Base URL
# ============================================
# For local development:
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# For production (replace with your domain):
# NEXT_PUBLIC_BASE_URL=https://your-domain.com

# ============================================
# REQUIRED: LinkedIn API Official (for publishing posts & analytics)
# ============================================
# Get from: https://www.linkedin.com/developers/apps
# 1. Create an app at LinkedIn Developer Portal
# 2. Request products: "Share on LinkedIn" + "Marketing Developer Platform"
# 3. Add Redirect URLs in OAuth 2.0 settings:
#    Dev: http://localhost:3000/api/linkedin/callback
#    Prod: https://your-domain.com/api/linkedin/callback

# App Credentials
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# Redirect URI (must match LinkedIn app settings)
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/linkedin/callback

# Scopes (space-separated)
# - w_member_social: Create/modify posts
# - r_basicprofile: Basic profile info  
# - r_member_postAnalytics: Get post analytics
LINKEDIN_SCOPES=w_member_social r_basicprofile r_member_postAnalytics

# ============================================
# REQUIRED: Unipile API (LinkedIn Integration - Legacy)
# ============================================
# Get from: https://dashboard.unipile.com
# DSN format: https://api{X}.unipile.com:{PORT}
UNIPILE_DSN=https://api1.unipile.com:13111
UNIPILE_ACCESS_TOKEN=your-unipile-access-token

# ============================================
# LinkedIn Community App (Analytics, Comments, SSI)
# ============================================
# This is a SECOND LinkedIn app for advanced features
# Requires Community Management API access
# Get from: https://www.linkedin.com/developers/apps (create second app)
LINKEDIN_COMMUNITY_CLIENT_ID=your-community-client-id
LINKEDIN_COMMUNITY_CLIENT_SECRET=your-community-client-secret
LINKEDIN_COMMUNITY_REDIRECT_URI=http://localhost:3000/api/linkedin-community/callback

# Community scopes (space-separated)
# - r_member_postAnalytics: View post analytics
# - r_organization_social_feed: View comments/reactions
# - r_1st_connections_size: Connections count
LINKEDIN_COMMUNITY_SCOPES=r_member_postAnalytics r_organization_social_feed r_1st_connections_size

# ============================================
# OPTIONAL: Stripe (for future subscriptions)
# ============================================
# STRIPE_SECRET_KEY=sk_live_your-stripe-key
# STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your-publishable-key
