# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs (will be created during Docker build)
.next
out
dist
build

# Environment files (these should be set in Railway)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Git
.git
.gitignore

# IDE
.idea
.vscode
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Documentation (not needed in production)
*.md
!README.md

# Credentials (should never be in Docker image)
*credentials*.json
*service-account*.json
gerador-imagens-*.json

# Logs
*.log
nginx/logs/

# SSL (handled separately)
nginx/ssl/
